# Firebase 웹 설정 (클라우드 저장/로그인용)
# Firebase 콘솔 → 프로젝트 설정 → 일반 → "내 앱"(웹 앱)에서 복사
# 이 값들은 공개돼도 되는 web config 이며, 실제 보안은 Firestore 규칙으로 한다.
# 사용하려면 이 파일을 `.env` 로 복사하고 값을 채운 뒤 dev/build 를 다시 실행하세요.

VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_PROJECT_ID=
VITE_FB_STORAGE_BUCKET=
VITE_FB_SENDER_ID=
VITE_FB_APP_ID=
